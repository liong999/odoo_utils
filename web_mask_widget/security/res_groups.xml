<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_masking" model="ir.module.category">
            <field name="name">Masking</field>
            <field name="description">User access level for sensitive data masking</field>
            <field name="sequence">30</field>
        </record>

        <!-- Masking Admin Group - users with this group can see unmasked sensitive data -->
        <record id="group_masking_admin" model="res.groups">
            <field name="name">Masking Admin</field>
            <field name="category_id" ref="web_mask_widget.module_category_masking"/>
            <field name="comment">Users with this group can see unmasked sensitive information (phone, email, ID, etc.)</field>
        </record>
    </data>
</odoo>
