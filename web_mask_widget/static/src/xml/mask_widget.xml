<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web_mask_widget.MaskSensitiveField">
        <t t-if="props.readonly">
            <span class="o_mask_sensitive_readonly" t-esc="displayValue" />
        </t>
        <t t-else="">
            <input
                class="o_input"
                t-att-id="props.id"
                type="text"
                t-att-placeholder="props.placeholder"
                t-ref="input"
                t-on-focus="onFocus"
                t-on-input="onInput"
                t-on-blur="onBlur"
                t-on-keydown="onKeydown"
            />
        </t>
    </t>

</templates>
